<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Persona 5 Stats Tracker</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            background-color: #000;
            color: #fff;
            font-family: 'Arial', sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 40px;
            max-width: 900px;
        }
        .chart-container {
            width: 400px;
            height: 400px;
        }
        .controls {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .stat-row {
            background: #e60012;
            padding: 10px 15px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 350px;
            transform: skew(-5deg);
        }
        .stat-info {
            transform: skew(5deg);
        }
        .stat-name {
            font-weight: bold;
            font-size: 1.1em;
            text-transform: uppercase;
        }
        .stat-rank {
            font-size: 0.9em;
            color: #ffcccc;
        }
        .buttons {
            display: flex;
            gap: 5px;
            transform: skew(5deg);
        }
        button {
            background: #fff;
            color: #e60012;
            border: none;
            padding: 5px 10px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 4px;
            transition: 0.2s;
        }
        button:hover {
            background: #000;
            color: #fff;
        }
        .reset-btn {
            margin-top: 20px;
            background: #333;
            color: #fff;
            padding: 10px 20px;
            border: 1px solid #fff;
        }
    </style>
</head>
<body>

    <h2>SOCIAL STATS</h2>
    
    <div class="container">
        <div class="chart-container">
            <canvas id="radarChart"></canvas>
        </div>

        <div class="controls" id="controlsPanel">
            <!-- Los botones se generan por JS -->
        </div>
    </div>
    
    <button class="reset-btn" onclick="resetStats()">RESET DATA</button>

    <script>
        // Nombres de stats y umbrales de rango
        const statNames = ["Knowledge", "Guts", "Proficiency", "Kindness", "Charm"];
        const maxPoints = 115;

        // Cargar datos de localStorage o iniciar en 0
        let stats = JSON.parse(localStorage.getItem("p5stats")) || {
            Knowledge: 0, Guts: 0, Proficiency: 0, Kindness: 0, Charm: 0
        };

        function getRank(points) {
            if (points >= 115) return "Rank 5 (MAX)";
            if (points >= 65) return "Rank 4";
            if (points >= 30) return "Rank 3";
            if (points >= 10) return "Rank 2";
            return "Rank 1";
        }

        function saveData() {
            localStorage.setItem("p5stats", JSON.stringify(stats));
        }

        // Configuración de Chart.js
        const ctx = document.getElementById('radarChart').getContext('2d');
        const radarChart = new Chart(ctx, {
            type: 'radar',
            data: {
                labels: statNames,
                datasets: [{
                    label: 'Puntos',
                    data: statNames.map(name => stats[name]),
                    backgroundColor: 'rgba(230, 0, 18, 0.5)', // Rojo P5
                    borderColor: '#e60012',
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#e60012',
                    borderWidth: 2
                }]
            },
            options: {
                scales: {
                    r: {
                        angleLines: { color: 'rgba(255, 255, 255, 0.2)' },
                        grid: { color: 'rgba(255, 255, 255, 0.2)' },
                        pointLabels: { color: '#fff', font: { size: 14, weight: 'bold' } },
                        ticks: { display: false, min: 0, max: maxPoints } // Oculta los números internos
                    }
                },
                plugins: { legend: { display: false } }
            }
        });

        function updateUI() {
            // Actualizar Gráfico
            radarChart.data.datasets[0].data = statNames.map(name => stats[name]);
            radarChart.update();

            // Actualizar Botones
            const panel = document.getElementById('controlsPanel');
            panel.innerHTML = '';
            
            statNames.forEach(stat => {
                const row = document.createElement('div');
                row.className = 'stat-row';
                row.innerHTML = `
                    <div class="stat-info">
                        <div class="stat-name">${stat}</div>
                        <div class="stat-rank">${getRank(stats[stat])} (${stats[stat]}/${maxPoints})</div>
                    </div>
                    <div class="buttons">
                        <button onclick="addPoints('${stat}', 1)">+1</button>
                        <button onclick="addPoints('${stat}', 2)">+2</button>
                        <button onclick="addPoints('${stat}', 3)">+3</button>
                    </div>
                `;
                panel.appendChild(row);
            });
        }

        function addPoints(stat, amount) {
            stats[stat] += amount;
            if (stats[stat] > maxPoints) stats[stat] = maxPoints;
            saveData();
            updateUI();
        }

        function resetStats() {
            if(confirm("¿Seguro que quieres borrar todo tu progreso?")) {
                stats = { Knowledge: 0, Guts: 0, Proficiency: 0, Kindness: 0, Charm: 0 };
                saveData();
                updateUI();
            }
        }

        // Iniciar interfaz
        updateUI();
    </script>
</body>
</html>
